        <div>Home</div>
        <div class="header-icons">
            🔍 ↻ ⊕ 👤
        </div>
    </div>

    <div class="my-work">My Work</div>

    <div onclick="mine()" class="list-item">
        <div class="icon" style="background:#238636;">⭕</div>
        <div class="item-text">Issues</div>
